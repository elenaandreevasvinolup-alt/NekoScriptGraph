        {
            "kind": "method",
            "leading": "\n\n// Только тело функции становится блоками; package и шапка переносятся как есть.\n// Внутри — письменное подмножество NSG.\n",
            "header": "func Crunch(n int) int ",
            "headerPrefix": "",
            "name": "Crunch",
            "headerBasePrefix": "",
            "baseList": "",
            "headerSuffix": "",
            "typeKeyword": "",
            "isContainer": false,
            "tail": "",
            "text": "",
            "printed": "{\n\tprimes := 0\n\ti := 2\n\tfor i <= n {\n\t\tisPrime := 1\n\t\tj := 2\n\t\tfor j*j <= i {\n\t\t\tif i%j == 0 {\n\t\t\t\tisPrime = 0\n\t\t\t}\n\t\t\tj += 1\n\t\t}\n\t\tprimes += isPrime\n\t\ti += 1\n\t}\n\tmask := (1 << 8) - 1\n\tfolded := (primes & mask) ^ (primes >> 3)\n\tbonus := -1\n\tif folded > 0 {\n\t\tbonus = folded\n\t}\n\treturn primes + bonus\n}",
            "line": 5,
            "children": []
        }
    ],
