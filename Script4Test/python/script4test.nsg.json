        },
        {
            "kind": "method",
            "leading": "",
            "header": "def crunch(n):\n",
            "headerPrefix": "",
            "name": "crunch",
            "headerBasePrefix": "",
            "baseList": "",
            "headerSuffix": "",
            "typeKeyword": "",
            "isContainer": false,
            "tail": "",
            "text": "",
            "printed": "    primes = 0\n    i = 2\n    while i <= n:\n        is_prime = 1\n        j = 2\n        while j * j <= i:\n            if i % j == 0:\n                is_prime = 0\n            j += 1\n        primes += is_prime\n        i += 1\n    mask = (1 << 8) - 1\n    folded = (primes & mask) ^ (primes >> 3)\n    bonus = -1\n    if folded > 0:\n        bonus = folded\n    return primes + bonus\n",
            "line": 3,
            "children": []
        }
    ],
