    "roots": [
        {
            "kind": "method",
            "leading": "// Только тело функции становится блоками; шапка переносится как есть.\n// Внутри — письменное подмножество NSG.\n",
            "header": "fn crunch(n: i32) -> i32 ",
            "headerPrefix": "",
            "name": "crunch",
            "headerBasePrefix": "",
            "baseList": "",
            "headerSuffix": "",
            "typeKeyword": "",
            "isContainer": false,
            "tail": "",
            "text": "",
            "printed": "{\n    let mut primes: i32 = 0;\n    let mut i: i32 = 2;\n    while i <= n {\n        let mut is_prime: i32 = 1;\n        let mut j: i32 = 2;\n        while j * j <= i {\n            if i % j == 0 {\n                is_prime = 0;\n            }\n            j += 1;\n        }\n        primes += is_prime;\n        i += 1;\n    }\n    let mask: i32 = (1 << 8) - 1;\n    let folded: i32 = (primes & mask) ^ (primes >> 3);\n    let bonus: i32 = if folded > 0 { folded } else { -1 };\n    return primes + bonus;\n}",
            "line": 3,
            "children": []
        }
    ],
