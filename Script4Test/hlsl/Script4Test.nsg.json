    "roots": [
        {
            "kind": "method",
            "leading": "// Только тело функции становится блоками; шапка и объявления переносятся\n// как есть. Внутри — письменное подмножество NSG.\n",
            "header": "float attenuate(float3 lightDir, float3 normal, float distance, float range)\n",
            "headerPrefix": "",
            "name": "attenuate",
            "headerBasePrefix": "",
            "baseList": "",
            "headerSuffix": "",
            "typeKeyword": "",
            "isContainer": false,
            "tail": "",
            "text": "",
            "printed": "{\n    float lambert = max(dot(normal, lightDir), 0.0);\n    float falloff = 1.0 - distance / range;\n    falloff = falloff < 0.0 ? 0.0 : falloff;\n    float squared = falloff * falloff;\n    float result = lambert * squared;\n    int i = 0;\n    while (i < 4)\n    {\n        result *= 0.5;\n        i++;\n    }\n    return result;\n}",
            "line": 4,
            "children": []
        }
    ],
