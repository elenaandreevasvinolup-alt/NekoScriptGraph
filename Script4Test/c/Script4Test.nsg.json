    "roots": [
        {
            "kind": "method",
            "leading": "/* Только тело функции становится блоками; шапка и includes переносятся как\n   есть. Внутри — письменное подмножество NSG: объявления, присваивания,\n   while/if, арифметика, приведение типа. */\n",
            "header": "int crunch(int n)\n",
            "headerPrefix": "",
            "name": "crunch",
            "headerBasePrefix": "",
            "baseList": "",
            "headerSuffix": "",
            "typeKeyword": "",
            "isContainer": false,
            "tail": "",
            "text": "",
            "printed": "{\n    int sieve[512];\n    int primes = 0;\n    int i = 0;\n    while (i <= n)\n    {\n        sieve[i] = 0;\n        i++;\n    }\n    i = 2;\n    while (i <= n)\n    {\n        if (sieve[i] == 0)\n        {\n            primes += 1;\n            int j = i * i;\n            while (j <= n)\n            {\n                sieve[j] = 1;\n                j += i;\n            }\n        }\n        i++;\n    }\n    int mask = (1 << 8) - 1;\n    int folded = (primes & mask) ^ (primes >> 3);\n    int bonus = folded > 0 ? folded : -1;\n    return primes + bonus;\n}",
            "line": 5,
            "children": []
        }
    ],
