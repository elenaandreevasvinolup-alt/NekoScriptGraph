        {
            "kind": "type",
            "leading": "\n\n// Только тело метода становится блоками; шапка файла переносится как есть.\n// Внутри — исключительно письменное подмножество NSG: объявления, присваивания,\n// while/if, арифметика и вызовы. Дженерики живут в ТЕКСТОВЫХ слотах (тип),\n// поэтому они не «сырой фрагмент», а полноценный блок.\n",
            "header": "public class Script4Test ",
            "headerPrefix": "public class ",
            "name": "Script4Test",
            "headerBasePrefix": "",
            "baseList": "",
            "headerSuffix": " ",
            "typeKeyword": "class",
            "isContainer": false,
            "tail": "\n}",
            "text": "",
            "printed": "",
            "line": 0,
            "children": [
                {
                    "kind": "method",
                    "leading": "\n\n    ",
                    "header": "public int crunch(int n) ",
                    "headerPrefix": "",
                    "name": "crunch",
                    "headerBasePrefix": "",
                    "baseList": "",
                    "headerSuffix": "",
                    "typeKeyword": "",
                    "isContainer": false,
                    "tail": "",
                    "text": "",
                    "printed": "{\n        List<Integer> sieve = new ArrayList<Integer>();\n        Map<String, Integer> tally = new HashMap<String, Integer>();\n        int primes = 0;\n        int i = 0;\n        while (i <= n) {\n            sieve.add(0);\n            i++;\n        }\n        i = 2;\n        while (i <= n) {\n            if (sieve.get(i) == 0) {\n                primes += 1;\n                tally.put(\"p\" + primes, i);\n                int j = i * i;\n                while (j <= n) {\n                    sieve.set(j, 1);\n                    j += i;\n                }\n            }\n            i++;\n        }\n        int mask = (1 << 8) - 1;\n        int folded = (primes & mask) ^ (primes >> 3);\n        int bonus = folded > 0 ? folded : -1;\n        return primes + bonus + tally.size();\n    }",
                    "line": 12,
                    "children": []
                }
            ]
        }
